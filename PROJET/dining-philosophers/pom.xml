<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>fr.cytech.hamoudilitim.philo</groupId>
    <artifactId>dining-philosophers</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Dining philosophers - microservices</name>

    <modules>
        <module>common</module>
        <module>monitor-service</module>
        <module>supervisor-service</module>
        <module>philosopher-service</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Mockito (Byte Buddy) ne reconnait pas encore les JDK récents (ex. 27) : on autorise le mode expérimental pour les tests -->
        <argLine>-Dnet.bytebuddy.experimental=true</argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>fr.cytech.hamoudilitim.philo</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>${project.artifactId}</finalName>
    </build>
</project>
